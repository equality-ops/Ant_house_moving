   24          void update_attitude(void) {
   25   1          float gx_raw, gy_raw, gz_raw;
   26   1          float gx_dps, gy_dps, gz_dps;
   27   1          float wx, wy, wz;
   28   1          Quat dq;
   29   1          Vec3 direction_pure;
   30   1          Quat temp_q; // 用于暂存四元数乘法结果，更安全
   31   1      
   32   1          imu660rb_get_gyro();
   33   1          gx_raw = (float)imu660rb_gyro_x;
   34   1          gy_raw = (float)imu660rb_gyro_y;
   35   1          gz_raw = (float)imu660rb_gyro_z;
   36   1      
   37   1          gx_dps = (gx_raw - gyro_bias_x) / (-GYRO_LSB_PER_DPS);
   38   1          gy_dps = (gy_raw - gyro_bias_y) / (-GYRO_LSB_PER_DPS);
   39   1          gz_dps = (gz_raw - gyro_bias_z) / (-GYRO_LSB_PER_DPS);
   40   1      
   41   1          wx = gx_dps * RAD_PER_DEG;
   42   1          wy = gy_dps * RAD_PER_DEG;
   43   1          wz = gz_dps * RAD_PER_DEG;
   44   1      
   45   1          // 使用指针传参更新四元数
   46   1          omega_to_dq(&dq, wx, wy, wz, DT);
   47   1          
   48   1          // 计算结果存放到 temp_q，再赋回给 q
   49   1          quat_mul(&temp_q, &q, &dq);
   50   1          q = temp_q;
   51   1          
   52   1          quat_normalize(&q, &q); // 我们在底层做了保护，这里原地修改是安全的
   53   1      
   54   1          rotate_vector_by_quat(&direction_pure, &q, &forward_body);  // 可选用
   55   1          quat_to_euler(&q, &roll_angle, &pitch_angle, &yaw_angle);
   56   1          yaw_angle += yaw_offset;
