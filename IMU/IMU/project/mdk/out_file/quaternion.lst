    3          void quat_mul(Quat *result, Quat *q1, Quat *q2) {
    4   1          // 提前读取，防止 q1/q2 和 result 是同一个指针导致的数据覆盖
    5   1          float w1 = q1->w, x1 = q1->x, y1 = q1->y, z1 = q1->z;
    6   1          float w2 = q2->w, x2 = q2->x, y2 = q2->y, z2 = q2->z;
    7   1      
    8   1          // 拆解乘法，避免单行表达式过长
    9   1          float t_w = w1*w2 - x1*x2 - y1*y2 - z1*z2;
   10   1          float t_x = w1*x2 + x1*w2 + y1*z2 - z1*y2;
   11   1          float t_y = w1*y2 - x1*z2 + y1*w2 + z1*x2;
   12   1          float t_z = w1*z2 + x1*y2 - y1*x2 + z1*w2;
   13   1      
   14   1          result->w = t_w;
   15   1          result->x = t_x;
   16   1          result->y = t_y;
   17   1          result->z = t_z;
   18   1      }
   19          
   20          void quat_conj(Quat *result, Quat *q) {
   21   1          result->w = q->w;
   22   1          result->x = -q->x;
   23   1          result->y = -q->y;
   24   1          result->z = -q->z;
   25   1      }
   26          
   27          float quat_norm(Quat *q) {
   28   1          // 拆解平方和计算
   29   1          float ww = q->w * q->w;
   30   1          float xx = q->x * q->x;
   31   1          float yy = q->y * q->y;
   32   1          float zz = q->z * q->z;
   33   1          return sqrt(ww + xx + yy + zz);
   34   1      }
   35          
   36          void quat_normalize(Quat *result, Quat *q) {
   37   1          float n = quat_norm(q);
   38   1          float inv;
   39   1          float t_w, t_x, t_y, t_z;
   40   1      
   41   1          if (n < 1e-9f) {
   42   2              result->w = 1.0f;
   43   2              result->x = 0.0f;
   44   2              result->y = 0.0f;
   45   2              result->z = 0.0f;
   46   2              return;
   47   2          }
   48   1          
   49   1          inv = 1.0f / n;
   50   1          
   51   1          // 暂存结果，允许原地修改 (如 quat_normalize(&q, &q))
   52   1          t_w = q->w * inv;
   53   1          t_x = q->x * inv;
   54   1          t_y = q->y * inv;
   55   1          t_z = q->z * inv;
   56   1      
C251 COMPILER V5.60.0,  quaternion                                                         09/04/26  23:46:45  PAGE 2   

   57   1          result->w = t_w;
   58   1          result->x = t_x;
   59   1          result->y = t_y;
   60   1          result->z = t_z;
   61   1      }
