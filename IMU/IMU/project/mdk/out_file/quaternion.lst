   63          void omega_to_dq(Quat *result, float wx, float wy, float wz, float dt) {
   64   1          float ww = wx*wx;
   65   1          float yy = wy*wy;
   66   1          float zz = wz*wz;
   67   1          float omega = sqrt(ww + yy + zz);
   68   1          float half_dt, theta, half, s;
   69   1      
   70   1          if (omega < 1e-9f) {
   71   2              half_dt = 0.5f * dt;
   72   2              result->w = 1.0f;
   73   2              result->x = wx * half_dt;
   74   2              result->y = wy * half_dt;
   75   2              result->z = wz * half_dt;
   76   2              quat_normalize(result, result);
   77   2              return;
   78   2          }
   79   1          
   80   1          theta = omega * dt;
   81   1          half = 0.5f * theta;
   82   1          s = sin(half) / omega;
   83   1          
   84   1          result->w = cos(half);
   85   1          result->x = wx * s;
   86   1          result->y = wy * s;
   87   1          result->z = wz * s;
   88   1          quat_normalize(result, result);
   89   1      }
