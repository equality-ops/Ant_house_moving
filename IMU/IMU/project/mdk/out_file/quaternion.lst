  111          void quat_to_euler(Quat *q, float *roll, float *pitch, float *yaw) {
  112   1          float w = q->w, x = q->x, y = q->y, z = q->z;
  113   1          float roll_rad, pitch_rad, yaw_rad;
  114   1          float roll_num, roll_den;
  115   1          float pitch_val;
  116   1          float yaw_num, yaw_den;
  117   1      
  118   1          // 彻底拆解复杂的三角函数和浮点表达式
  119   1          roll_num = 2.0f * (w*x + y*z);
  120   1          roll_den = 1.0f - 2.0f * (x*x + y*y);
  121   1          roll_rad = atan2(roll_num, roll_den);
  122   1          
C251 COMPILER V5.60.0,  quaternion                                                         09/04/26  23:46:45  PAGE 3   

  123   1          pitch_val = 2.0f * (w*y - z*x);
  124   1          // 限幅保护：浮点误差可能导致 pitch_val 略大于 1，引发 asin 崩溃
  125   1          if (pitch_val > 1.0f) pitch_val = 1.0f;
  126   1          else if (pitch_val < -1.0f) pitch_val = -1.0f;
  127   1          pitch_rad = asin(pitch_val);
  128   1          
  129   1          yaw_num = 2.0f * (w*z + x*y);
  130   1          yaw_den = 1.0f - 2.0f * (y*y + z*z);
  131   1          yaw_rad = atan2(yaw_num, yaw_den);
  132   1          
  133   1          *roll = roll_rad * 180.0f / 3.1415f;
  134   1          *pitch = pitch_rad * 180.0f / 3.1415f;
  135   1          *yaw = yaw_rad * 180.0f / 3.1415f;
  136   1      }


