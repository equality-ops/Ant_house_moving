   91          void rotate_vector_by_quat(Vec3 *result, Quat *q, Vec3 *v) {
   92   1          Quat vq;
   93   1          Quat q_conj;
   94   1          Quat temp;
   95   1          Quat rotated;
   96   1          
   97   1          vq.w = 0.0f;
   98   1          vq.x = v->x;
   99   1          vq.y = v->y;
  100   1          vq.z = v->z;
  101   1          
  102   1          quat_conj(&q_conj, q);
  103   1          quat_mul(&temp, q, &vq);
  104   1          quat_mul(&rotated, &temp, &q_conj);
  105   1          
  106   1          result->x = rotated.x;
  107   1          result->y = rotated.y;
  108   1          result->z = rotated.z;
  109   1      }
